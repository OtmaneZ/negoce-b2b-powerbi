/// Étapes du pont de marge commerciale : les cinq effets qui expliquent l'écart de marge avec N-1. Table utilitaire sans relation, lue par la mesure Pont de marge.
table 'Étape du pont'

	/// Étape du pont de marge, dans l'ordre de lecture du graphique en cascade.
	column 'Étape'
		dataType: string
		summarizeBy: none
		sourceColumn: Étape
		sortByColumn: Ordre

	/// Ordre d'affichage des étapes, de 1 à 5.
	column Ordre
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: Ordre

	partition 'Étape du pont' = m
		mode: import
		source =
				let
					Source = #table(type table [Ordre = Int64.Type, #"Étape" = text], {{1, "Volume"}, {2, "Mix"}, {3, "Prix catalogue"}, {4, "Remises"}, {5, "Coût d'achat"}})
				in
					Source
